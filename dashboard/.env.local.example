# GYWD Dashboard Configuration
#
# API Gateway connection (optional — dashboard falls back to direct filesystem reads)
GYWD_API_URL=http://localhost:3945
NEXT_PUBLIC_GYWD_API_URL=http://localhost:3945

# API key for authenticated gateway (optional — leave empty if GYWD_API_AUTH=disabled on gateway)
GYWD_API_KEY=

# Set to "disabled" to skip API key auth
GYWD_API_AUTH=disabled
